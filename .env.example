# Database & output paths
RL_DB_PATH=rocketleague.db
RL_EXPORT_DIR=exports
RL_LOG_DIR=logs

# Source endpoints (public pages / APIs)
RL_BLAST_BASE_URL=https://blast.tv/rl
RL_BLAST_API_BASE_URL=https://api.blast.tv
RL_LIQUIPEDIA_BASE_URL=https://liquipedia.net/rocketleague
# Optional community sheets (comma-separated CSV export URLs). Leave empty to skip.
RL_DREKT_CSV_URLS=

# Rate limits & concurrency (keep conservative)
RL_HTTP_TIMEOUT_SECONDS=30
RL_BLAST_RATE_LIMIT_SECONDS=0.75
RL_LIQUIPEDIA_RATE_LIMIT_SECONDS=2.0
RL_SPREADSHEET_RATE_LIMIT_SECONDS=0.25
RL_MAX_CONCURRENCY=6

# Browser fingerprint seed for JS-heavy BLAST pages
RL_BLAST_FINGERPRINT_SEED=42069
RL_BLAST_PROBE_DEEP_STATS=false
RL_BLAST_MAX_DISCOVERED_TOURNAMENTS=16

# Request identity — set a real contact email before heavy runs
RL_USER_AGENT=RocketLeagueResearchBot/0.1 (+https://github.com/ark-daemon/rocket-league-scraper; contact: you@example.com)

# Discovery seeds (comma-separated)
RL_BLAST_TOURNAMENT_SLUGS=rlcs-world-championship-2026
RL_LIQUIPEDIA_SEED_PAGES=Rocket_League_Championship_Series/2026,Rocket_League_Championship_Series/2025,Transfers
RL_RLCS_REGIONS=NA,EU,SAM,OCE,MENA,APAC,SSA
